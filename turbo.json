{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@nudo-tsl/codegen#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/editor/src/examples/*.graph.json",
        "$TURBO_ROOT$/packages/runtime/src/*.ts"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "E2E_PORT", "E2E_GPU"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
