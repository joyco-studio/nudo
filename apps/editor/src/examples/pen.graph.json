    "frame-cross": {
      "id": "frame-cross",
      "type": "utility/comment",
      "position": {
        "x": -4280,
        "y": 688
      },
      "inputValues": {},
      "params": {
        "body": "The same lines at Cross-hatch angle, held back by Cross-hatch delay: they only start once the tone is that much darker, so they cross the hatching in the shadows alone.",
        "height": 843,
        "title": "Cross-hatching",
        "width": 2480
      }
    },
    "frame-flow": {
      "id": "frame-flow",
      "type": "utility/comment",
      "position": {
        "x": -10504,
        "y": 479
      },
      "inputValues": {},
      "params": {
        "body": "A 2D Perlin over view space, remapped to 0…1: where the ballpoint runs wet or dry. A dry run lifts the lines’ edge by up to 0.12, so they narrow, and pales the ink to 0.7.",
        "height": 870,
        "title": "Ink flow",
        "width": 1248
      }
    },
    "frame-hatch": {
      "id": "frame-hatch",
      "type": "utility/comment",
      "position": {
        "x": -6856,
        "y": 372
      },
      "inputValues": {},
      "params": {
        "body": "View space turned by Hatch angle; its Y plus the wobble, × density through a sine, gives parallel lines. AA Step draws them where the wave rises above the tone and the dry edge: none in full light, wider as the light falls, thinner where the ink runs dry. Max stops the tone at 0.3, so a line never widens past a ballpoint’s and the gaps stay.",
        "height": 859,
        "title": "Hatching",
        "width": 2480
      }
    },
    "frame-ink": {
      "id": "frame-ink",
      "type": "utility/comment",
      "position": {
        "x": -1704,
        "y": 42
      },
      "inputValues": {},
      "params": {
        "body": "Hatching, cross-hatching and outline add up, × Ink density: one pass of translucent ink, so where lines cross they darken as a second pass of a ballpoint does. × the flow ink and the tooth specks, Clamp holds it to 0…1 and Blend multiplies the ink over the paper by it.",
        "height": 494,
        "title": "Ink",
        "width": 2208
      }
    },
    "frame-light": {
      "id": "frame-light",
      "type": "utility/comment",
      "position": {
        "x": -8520,
        "y": -8
      },
      "inputValues": {},
      "params": {
        "body": "Main Light → Half Lambert, squared as Valve shades with it: 1 facing the light, 0.25 edge-on, 0 facing away. Contrast stretches it around 0.5, so the ink reaches the shadows sooner.",
        "height": 458,
        "title": "Light",
        "width": 1568
      }
    },
    "frame-outline": {
      "id": "frame-outline",
      "type": "utility/comment",
      "position": {
        "x": -2408,
        "y": 167
      },
      "inputValues": {},
      "params": {
        "body": "Fresnel grows toward the edges that turn away from you; AA Step cuts it into a contour line. Raise Outline to thin it.",
        "height": 489,
        "title": "Outline",
        "width": 608
      }
    },
    "frame-paper": {
      "id": "frame-paper",
      "type": "utility/comment",
      "position": {
        "x": -3368,
        "y": -1017
      },
      "inputValues": {},
      "params": {
        "body": "Paper made of two noises in view space, so it stays put while the mesh turns: soft clouds of pulp and a fine tooth. Their sum, remapped, darkens the paper color a little.",
        "height": 1152,
        "title": "Paper",
        "width": 1568
      }
    },
    "frame-tooth": {
      "id": "frame-tooth",
      "type": "utility/comment",
      "position": {
        "x": -9160,
        "y": 1224
      },
      "inputValues": {},
      "params": {
        "body": "View-space X and Y cut into cells by Floor, and Random gives each cell a height. Smoothstep and Remap turn the low cells into pale specks: unlike graphite the ink never drops below 0.65, so a line stays whole.",
        "height": 658,
        "title": "Paper tooth",
        "width": 2208
      }
    },
    "frame-wobble": {
      "id": "frame-wobble",
      "type": "utility/comment",
      "position": {
        "x": -7560,
        "y": 482
      },
      "inputValues": {},
      "params": {
        "body": "A soft noise over view space, scaled by Wobble: how far a line strays from a ruler. Both hatchings share it, so their lines bend together like one hand drew them.",
        "height": 710,
        "title": "Hand",
        "width": 608
      }
    },
