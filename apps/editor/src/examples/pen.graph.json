    "frame-cross": {
      "id": "frame-cross",
      "type": "utility/comment",
      "position": {
        "x": -4600,
        "y": 1334
      },
      "inputValues": {},
      "params": {
        "body": "The same lines at Cross-hatch angle, held back by Cross-hatch delay: they only start once the tone is that much darker, so they cross the hatching in the shadows alone.",
        "height": 960,
        "title": "Cross-hatching",
        "width": 3120
      }
    },
    "frame-flow": {
      "id": "frame-flow",
      "type": "utility/comment",
      "position": {
        "x": -8568,
        "y": 729
      },
      "inputValues": {},
      "params": {
        "body": "A 2D Perlin over view space: where the ballpoint runs wet or dry. Remap and Clamp take it to 0…1; a dry line narrows to 0.68 of its width and pales to 0.7 of its ink.",
        "height": 854,
        "title": "Ink flow",
        "width": 1568
      }
    },
    "frame-hatch": {
      "id": "frame-hatch",
      "type": "utility/comment",
      "position": {
        "x": -4600,
        "y": 351
      },
      "inputValues": {},
      "params": {
        "body": "View space turned by Hatch angle; its Y plus the wobble, × density, through Fract: how far each point is from the middle of its line. The width grows from 0 in full light to the whole gap in shadow, × the flow width, and a soft-edged core inks it.",
        "height": 951,
        "title": "Hatching",
        "width": 3120
      }
    },
    "frame-ink": {
      "id": "frame-ink",
      "type": "utility/comment",
      "position": {
        "x": -1384,
        "y": 42
      },
      "inputValues": {},
      "params": {
        "body": "Hatching, cross-hatching and outline add up, × the flow ink and the tooth specks. Clamp holds it to 0…1 and Blend multiplies the ink over the paper by it.",
        "height": 531,
        "title": "Ink",
        "width": 1888
      }
    },
    "frame-light": {
      "id": "frame-light",
      "type": "utility/comment",
      "position": {
        "x": -6264,
        "y": 1053
      },
      "inputValues": {},
      "params": {
        "body": "Main Light → Half Lambert, squared as Valve shades with it: 1 facing the light, 0.25 edge-on, 0 facing away. Contrast stretches it around 0.5, so the ink reaches the shadows sooner.",
        "height": 458,
        "title": "Light",
        "width": 1568
      }
    },
    "frame-outline": {
      "id": "frame-outline",
      "type": "utility/comment",
      "position": {
        "x": -2088,
        "y": -170
      },
      "inputValues": {},
      "params": {
        "body": "Fresnel grows toward the edges that turn away from you; AA Step cuts it into a contour line. Raise Outline to thin it.",
        "height": 489,
        "title": "Outline",
        "width": 608
      }
    },
    "frame-paper": {
      "id": "frame-paper",
      "type": "utility/comment",
      "position": {
        "x": -3048,
        "y": -1242
      },
      "inputValues": {},
      "params": {
        "body": "Paper made of two noises in view space, so it stays put while the mesh turns: soft clouds of pulp and a fine tooth. Their sum, remapped, darkens the paper color a little.",
        "height": 1040,
        "title": "Paper",
        "width": 1568
      }
    },
    "frame-tooth": {
      "id": "frame-tooth",
      "type": "utility/comment",
      "position": {
        "x": -6904,
        "y": 363
      },
      "inputValues": {},
      "params": {
        "body": "View-space X and Y cut into cells by Floor, and Random gives each cell a height. Smoothstep and Remap turn the low cells into pale specks: the ink never drops below 0.65, so the line stays whole.",
        "height": 658,
        "title": "Paper tooth",
        "width": 2208
      }
    },
    "frame-wobble": {
      "id": "frame-wobble",
      "type": "utility/comment",
      "position": {
        "x": -5304,
        "y": 1543
      },
      "inputValues": {},
      "params": {
        "body": "A soft noise over view space, scaled by Wobble: how far a line strays from a ruler. Both hatchings share it, so their lines bend together like one hand drew them.",
        "height": 654,
        "title": "Hand",
        "width": 608
      }
    },
