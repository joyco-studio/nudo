        "title": "Ink",
        "width": 608
      }
    },
    "frame-light": {
      "id": "frame-light",
      "type": "utility/comment",
      "position": {
        "x": -3752,
        "y": 696
      },
      "inputValues": {},
      "params": {
        "body": "Main Light → Half Lambert, squared as Valve shades with it: 1 facing the light, 0.25 edge-on, 0 facing away. Contrast stretches it around 0.5, so the ink reaches the shadows sooner.",
        "height": 458,
        "title": "Light",
        "width": 1568
      }
    },
    "frame-paper": {
      "id": "frame-paper",
      "type": "utility/comment",
      "position": {
        "x": -1768,
        "y": -605
      },
      "inputValues": {},
      "params": {
        "body": "Paper made of two noises in view space, so it stays put while the mesh turns: soft clouds of pulp and a fine tooth. Their sum, remapped, darkens the paper color a little.",
        "height": 1040,
        "title": "Paper",
        "width": 1568
      }
    },
    "frame-pressure": {
      "id": "frame-pressure",
      "type": "utility/comment",
      "position": {
        "x": -2088,
        "y": 467
      },
      "inputValues": {},
      "params": {
        "body": "Remap counts the strokes (one per turn of the sine, cut where it is lowest) and Floor numbers them. Random turns each number into its own value, so every stroke presses a little harder or softer.",
