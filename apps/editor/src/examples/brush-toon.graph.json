    "frame-edges": {
      "id": "frame-edges",
      "type": "utility/comment",
      "position": {
        "x": -744,
        "y": -529
      },
      "inputValues": {},
      "params": {
        "body": "The bundled stroke mask, twice as fine as the brush: white strokes with dark gaps. Fresnel rises toward the silhouette; there Lerp swaps full opacity for the mask, and Alpha Clip cuts away what falls under Edge bite, so the edge frays along the strokes. 0 keeps the edge whole.",
        "height": 912,
        "title": "Brushed-off edges",
        "width": 1248
      }
    },
    "frame-facets": {
      "id": "frame-facets",
      "type": "utility/comment",
      "position": {
        "x": -5352,
        "y": 689
      },
      "inputValues": {},
      "params": {
        "body": "Voronoi 3D over a noise-bent position cuts the mesh into cells. Random gives each cell its own direction (Out3, moved to -1…1); added to the normal × facet tilt, it tips every cell toward or away from the light like a flat brush dab.",
        "height": 740,
        "title": "Painted facets",
        "width": 3168
      }
    },
    "frame-light": {
      "id": "frame-light",
      "type": "utility/comment",
      "position": {
        "x": -2088,
        "y": 438
      },
      "inputValues": {},
      "params": {
        "body": "Main Light's Half Lambert on the faceted normal: Blender's Shader to RGB. The brush value, around its middle × paint, shifts it so the colors break along the strokes. Remap squeezes it into the band the palette sits in.",
        "height": 744,
        "title": "Light as a value",
        "width": 1248
      }
    },
    "frame-palette": {
      "id": "frame-palette",
      "type": "utility/comment",
      "position": {
        "x": -104,
        "y": 415
      },
      "inputValues": {},
      "params": {
        "body": "The five colors of the Blender ramp at its positions: navy up to 0.80, then blue, green, coral and cream. Smooth eases between them, like its B-spline. The brush texture goes over them in soft light, half strength, so the streaks show in every color.",
        "height": 757,
        "title": "Palette",
        "width": 608
      }
    },
    "frame-strokes": {
      "id": "frame-strokes",
      "type": "utility/comment",
      "position": {
        "x": -3752,
        "y": 60
      },
      "inputValues": {},
      "params": {
        "body": "The bundled brush texture, read at the UV × 2, 1 (a sphere runs twice as far around as up) × brush scale: flat strokes in many greys, with bristle streaks and dry gaps. Its grey is the brush value.",
        "height": 597,
        "title": "Brush strokes",
        "width": 1568
      }
    },
