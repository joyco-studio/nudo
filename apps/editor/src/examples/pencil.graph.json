    "frame-cross": {
      "id": "frame-cross",
      "type": "utility/comment",
      "position": {
        "x": -3960,
        "y": 308
      },
      "inputValues": {},
      "params": {
        "body": "The same strokes at Cross-hatch angle, held back by Cross-hatch delay: they only start once the tone is that much darker, so they cross the hatching in the shadows alone.",
        "height": 843,
        "title": "Cross-hatching",
        "width": 2480
      }
    },
    "frame-graphite": {
      "id": "frame-graphite",
      "type": "utility/comment",
      "position": {
        "x": -1384,
        "y": 41
      },
      "inputValues": {},
      "params": {
        "body": "Hatching, cross-hatching and outline add up, × Pressure, and the tooth keeps only the grain they land on: harder pressure, or strokes crossing, fill more of it, as a second pass of a pencil does. Clamp holds it to 0…1 and Blend multiplies the graphite over the paper by it.",
        "height": 474,
        "title": "Graphite",
        "width": 1888
      }
    },
    "frame-hatch": {
      "id": "frame-hatch",
      "type": "utility/comment",
      "position": {
        "x": -3960,
        "y": 1183
      },
      "inputValues": {},
      "params": {
        "body": "View space turned by Hatch angle; its Y plus the wobble, × density through a sine, gives parallel strokes. AA Step draws them where the wave rises above the tone: none in full light, wider as the light falls.",
        "height": 605,
        "title": "Hatching",
        "width": 2480
      }
    },
    "frame-light": {
      "id": "frame-light",
      "type": "utility/comment",
      "position": {
        "x": -5624,
        "y": 1098
      },
      "inputValues": {},
      "params": {
        "body": "Main Light → Half Lambert, squared as Valve shades with it: 1 facing the light, 0.25 edge-on, 0 facing away. Contrast stretches it around 0.5, so the ink reaches the shadows sooner.",
        "height": 458,
        "title": "Light",
        "width": 1568
      }
    },
    "frame-outline": {
      "id": "frame-outline",
      "type": "utility/comment",
      "position": {
        "x": -2088,
        "y": -213
      },
      "inputValues": {},
      "params": {
        "body": "Fresnel grows toward the edges that turn away from you; AA Step cuts it into a contour line. Raise Outline to thin it.",
        "height": 489,
        "title": "Outline",
        "width": 608
      }
    },
    "frame-paper": {
      "id": "frame-paper",
      "type": "utility/comment",
      "position": {
        "x": -3048,
        "y": -1397
      },
      "inputValues": {},
      "params": {
        "body": "Paper made of two noises in view space, so it stays put while the mesh turns: soft clouds of pulp and a fine tooth. Their sum, remapped, darkens the paper color a little.",
        "height": 1152,
        "title": "Paper",
        "width": 1568
      }
    },
    "frame-tooth": {
      "id": "frame-tooth",
      "type": "utility/comment",
      "position": {
        "x": -8568,
        "y": 480
      },
      "inputValues": {},
      "params": {
        "body": "View-space X and Y cut into cells by Floor, and Random gives each cell a height: the fine tooth, and a coarse one three cells wide. Smoothstep keeps the high fine cells and the coarse one varies them, so graphite only catches on part of the sheet.",
        "height": 881,
        "title": "Paper tooth",
        "width": 2848
      }
    },
    "frame-wobble": {
      "id": "frame-wobble",
      "type": "utility/comment",
      "position": {
        "x": -4664,
        "y": 356
      },
      "inputValues": {},
      "params": {
        "body": "A soft noise over view space, scaled by Wobble: how far a stroke strays from a ruler line. Both hatchings share it, so their lines bend together like one hand drew them.",
        "height": 710,
        "title": "Hand",
        "width": 608
      }
    },
