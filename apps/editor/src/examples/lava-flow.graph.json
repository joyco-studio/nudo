      "type": "utility/comment",
      "position": {
        "x": -2408,
        "y": 178
      },
      "inputValues": {},
      "params": {
        "body": "The original's formula: color × pulse × 2 + color² − 0.1. It can pass 1: the next step uses what is over.",
