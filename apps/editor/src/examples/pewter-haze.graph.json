    "frame-bands": {
      "id": "frame-bands",
      "type": "utility/comment",
      "position": {
        "x": -2360,
        "y": 76
      },
      "inputValues": {},
      "params": {
        "body": "Blender's Shader to RGB: base tone × light (a metal mostly reflects the world instead), with the paint added the way the .blend feeds it into Emission. Its luma picks a color on the Color Ramp: flat bands, like strokes of paint.",
        "height": 686,
        "title": "Paint bands",
        "width": 2208
      }
    },
    "frame-base-tone": {
      "id": "frame-base-tone",
      "type": "utility/comment",
      "position": {
        "x": -4024,
        "y": -958
      },
      "inputValues": {},
      "params": {
        "body": "The Principled BSDF's base color: a spherical gradient, placed by a Mapping, mixed with a fine Voronoi grain (Minkowski 2 is the true Euclidean distance Blender measures).",
        "height": 937,
        "title": "Base tone",
        "width": 1568
      }
    },
    "frame-brush-normals": {
      "id": "frame-brush-normals",
      "type": "utility/comment",
      "position": {
        "x": -6648,
        "y": 11
      },
      "inputValues": {},
      "params": {
        "body": "The normal, bent by Noise Color in Linear Light, snaps to the cells of a Minkowski Voronoi: its exponent below 1 pinches each cell into a star. The normalized cell is the new normal, so the light breaks into brush-stroke facets.",
        "height": 917,
        "title": "Brush normals",
        "width": 1248
      }
    },
    "frame-coords": {
      "id": "frame-coords",
      "type": "utility/comment",
      "position": {
        "x": -8632,
        "y": 413
      },
      "inputValues": {},
      "params": {
        "body": "Blender's Generated coordinates run from 0 to 1 over the object's bounds, with Z up. Position turned to Z up (X, −Z, Y), × 0.5 + 0.5, gives the same on a unit sphere, so the scales and rotations copied from the .blend still fit.",
        "height": 590,
        "title": "Generated coordinates",
        "width": 1888
      }
    },
    "frame-finish": {
      "id": "frame-finish",
      "type": "utility/comment",
      "position": {
        "x": -56,
        "y": 66
      },
      "inputValues": {},
      "params": {
        "body": "The paint, overlaid on the bands as in the .blend.",
        "height": 448,
        "title": "Overlay",
        "width": 560
      }
    },
    "frame-light": {
      "id": "frame-light",
      "type": "utility/comment",
      "position": {
        "x": -5304,
        "y": 11
      },
      "inputValues": {},
      "params": {
        "body": "The .blend's light on the brush normal: its sky lights every side by about 0.3, and its sun adds about half the Main Light's Lambert. A Blinn highlight (the normal against the halfway between light and view) adds the gloss.",
        "height": 1131,
        "title": "Light",
        "width": 2848
      }
    },
    "frame-paint": {
      "id": "frame-paint",
      "type": "utility/comment",
      "position": {
        "x": -4664,
        "y": 1174
      },
      "inputValues": {},
      "params": {
        "body": "The .blend overlays a paint image; here it is thin scan lines, the fraction of Y × Scale cut by a Step. It runs from the dark to the light paint color, then through Bright/Contrast with the .blend's settings.",
        "height": 801,
        "title": "Paint",
        "width": 2208
      }
    },
